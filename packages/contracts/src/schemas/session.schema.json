{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://ai-pentest.com/schemas/session.schema.json",
  "title": "Session",
  "type": "object",
  "properties": {
    "id": { "type": "string", "format": "uuid" },
    "name": { "type": "string" },
    "target": { "type": "string" },
    "status": {
      "type": "string",
      "enum": ["idle", "active", "paused", "completed", "failed"]
    },
    "createdAt": { "type": "string", "format": "date-time" },
    "updatedAt": { "type": "string", "format": "date-time" },
    "endTime": { "type": "string", "format": "date-time" },
    "tags": { "type": "array", "items": { "type": "string" } },
    "config": { "type": "object", "additionalProperties": true },
    "metadata": { "type": "object", "additionalProperties": true },
    "version": { "type": "integer" },
    "state": {
      "type": "object",
      "properties": {
        "currentPhase": { "type": "string" },
        "knownFacts": { "type": "array", "items": { "type": "string" } },
        "pinnedFacts": { "type": "array", "items": { "type": "string" } },
        "openQuestions": { "type": "array", "items": { "type": "string" } },
        "actionHistory": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "action": { "type": "string" },
              "result": { "type": "object", "additionalProperties": true },
              "timestamp": { "type": "string", "format": "date-time" }
            },
            "required": ["action", "timestamp"]
          }
        },
        "chatHistory": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "role": { "type": "string", "enum": ["user", "assistant", "system"] },
              "content": { "type": "string" },
              "timestamp": { "type": "string", "format": "date-time" }
            },
            "required": ["role", "content", "timestamp"]
          }
        },
        "summary": { "type": "string" },
        "confidenceSnapshot": { "type": "number", "minimum": 0, "maximum": 1 }
      },
      "required": ["currentPhase", "knownFacts", "pinnedFacts", "openQuestions", "actionHistory", "chatHistory", "confidenceSnapshot"]
    }
  },
  "required": ["id", "name", "target", "status", "createdAt", "updatedAt", "state", "version"]
}
