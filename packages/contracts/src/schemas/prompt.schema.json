{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://ai-pentest.com/schemas/prompt.schema.json",
  "title": "Prompt Module",
  "type": "object",
  "properties": {
    "id": { "type": "string" },
    "name": { "type": "string" },
    "version": { "type": "string" },
    "description": { "type": "string" },
    "template": { "type": "string" },
    "inputVariables": {
      "type": "array",
      "items": { "type": "string" }
    },
    "outputFormat": { "type": "string" },
    "tags": {
      "type": "array",
      "items": { "type": "string" }
    },
    "author": { "type": "string" },
    "category": { "type": "string" },
    "changelog": { "type": "string" },
    "metadata": { "type": "object" }
  },
  "required": ["id", "name", "version", "description", "template", "inputVariables"]
}
