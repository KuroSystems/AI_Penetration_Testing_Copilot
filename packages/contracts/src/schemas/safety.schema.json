{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://ai-pentest.com/schemas/safety.schema.json",
  "title": "Safety Rule",
  "type": "object",
  "properties": {
    "id": { "type": "string" },
    "name": { "type": "string" },
    "description": { "type": "string" },
    "pattern": { "type": "string" },
    "category": { "type": "string" },
    "severity": {
      "type": "string",
      "enum": ["low", "medium", "high"]
    },
    "action": {
      "type": "string",
      "enum": ["allow", "block", "flag", "modify"]
    },
    "message": { "type": "string" },
    "metadata": { "type": "object", "additionalProperties": true }
  },
  "required": ["id", "name", "severity", "action", "message"]
}
