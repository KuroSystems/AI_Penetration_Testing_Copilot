{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://ai-pentest.com/schemas/workflow.schema.json",
  "title": "Stage Graph",
  "type": "object",
  "properties": {
    "id": { "type": "string" },
    "name": { "type": "string" },
    "initialStage": { "type": "string" },
    "stages": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "description": { "type": "string" },
          "nextPossibleStages": {
            "type": "array",
            "items": { "type": "string" }
          },
          "metadata": { "type": "object", "additionalProperties": true }
        },
        "required": ["id", "name", "description", "nextPossibleStages"]
      }
    },
    "version": { "type": "string" }
  },
  "required": ["id", "name", "initialStage", "stages", "version"]
}
