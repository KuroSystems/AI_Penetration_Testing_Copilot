{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.aiptc.dev/contracts/v0.1.0/EmbeddingRequest.schema.json",
  "title": "Embedding request",
  "description": "Provider-agnostic embedding request.",
  "x-contract": {
    "id": "EmbeddingRequest",
    "group": "model",
    "contractsVersion": "0.1.0",
    "foundational": false
  },
  "type": "object",
  "properties": {
    "model": {
      "type": "string",
      "maxLength": 200
    },
    "input": {
      "minItems": 1,
      "maxItems": 512,
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 100000
      }
    },
    "dimensions": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "sensitivity": {
      "type": "string",
      "enum": [
        "public",
        "internal",
        "confidential",
        "restricted",
        "secret"
      ],
      "description": "Handling classification; drives redaction and egress policy"
    },
    "providerOptions": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "$ref": "https://schemas.aiptc.dev/contracts/v0.1.0/__shared.schema.json#/$defs/JsonValue"
      }
    }
  },
  "required": [
    "input"
  ],
  "additionalProperties": false
}
