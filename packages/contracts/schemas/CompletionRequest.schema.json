{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.aiptc.dev/contracts/v0.1.0/CompletionRequest.schema.json",
  "title": "Completion request",
  "description": "Provider-agnostic chat/completion request.",
  "x-contract": {
    "id": "CompletionRequest",
    "group": "model",
    "contractsVersion": "0.1.0",
    "foundational": false
  },
  "type": "object",
  "properties": {
    "callId": {
      "type": "string",
      "pattern": "^mcl_(?:[0-9A-HJKMNP-TV-Z]{26}|[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12})$",
      "description": "Model call identifier (`mcl_<ulid|uuid>`)"
    },
    "sessionId": {
      "type": "string",
      "pattern": "^ses_(?:[0-9A-HJKMNP-TV-Z]{26}|[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12})$",
      "description": "Session identifier (`ses_<ulid|uuid>`)"
    },
    "model": {
      "type": "string",
      "maxLength": 200
    },
    "messages": {
      "minItems": 1,
      "maxItems": 2048,
      "type": "array",
      "items": {
        "$ref": "https://schemas.aiptc.dev/contracts/v0.1.0/__shared.schema.json#/$defs/ModelMessage"
      }
    },
    "tools": {
      "maxItems": 256,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "description": {
            "type": "string",
            "maxLength": 8000,
            "description": "Human-readable description (markdown allowed)"
          },
          "inputSchema": {
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {
              "$ref": "https://schemas.aiptc.dev/contracts/v0.1.0/__shared.schema.json#/$defs/JsonValue"
            }
          },
          "readOnly": {
            "type": "boolean"
          }
        },
        "required": [
          "name",
          "description",
          "inputSchema"
        ],
        "additionalProperties": false
      }
    },
    "toolChoice": {
      "anyOf": [
        {
          "type": "string",
          "enum": [
            "auto",
            "none",
            "required"
          ]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "tool"
            },
            "name": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            }
          },
          "required": [
            "type",
            "name"
          ],
          "additionalProperties": false
        }
      ]
    },
    "responseFormat": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "text"
            }
          },
          "required": [
            "type"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "json"
            }
          },
          "required": [
            "type"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "json-schema"
            },
            "name": {
              "type": "string",
              "minLength": 1,
              "maxLength": 96,
              "pattern": "^[a-z0-9]([a-z0-9-]*[a-z0-9])?(\\.[a-z0-9]([a-z0-9-]*[a-z0-9])?)*$",
              "description": "Lowercase machine name, e.g. \"recon.port-scan\""
            },
            "schema": {
              "type": "object",
              "propertyNames": {
                "type": "string"
              },
              "additionalProperties": {
                "$ref": "https://schemas.aiptc.dev/contracts/v0.1.0/__shared.schema.json#/$defs/JsonValue"
              }
            },
            "strict": {
              "type": "boolean"
            }
          },
          "required": [
            "type",
            "schema"
          ],
          "additionalProperties": false
        }
      ]
    },
    "temperature": {
      "type": "number",
      "minimum": 0,
      "maximum": 2
    },
    "topP": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "topK": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "maxOutputTokens": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "stopSequences": {
      "maxItems": 8,
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 64
      }
    },
    "presencePenalty": {
      "type": "number",
      "minimum": -2,
      "maximum": 2
    },
    "frequencyPenalty": {
      "type": "number",
      "minimum": -2,
      "maximum": 2
    },
    "seed": {
      "type": "integer",
      "minimum": -9007199254740991,
      "maximum": 9007199254740991
    },
    "timeoutMs": {
      "type": "integer",
      "minimum": 0,
      "maximum": 2147483647,
      "description": "Duration in milliseconds"
    },
    "idempotencyKey": {
      "type": "string",
      "maxLength": 200
    },
    "sensitivity": {
      "type": "string",
      "enum": [
        "public",
        "internal",
        "confidential",
        "restricted",
        "secret"
      ],
      "description": "Handling classification; drives redaction and egress policy"
    },
    "providerOptions": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "$ref": "https://schemas.aiptc.dev/contracts/v0.1.0/__shared.schema.json#/$defs/JsonValue"
      }
    },
    "metadata": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "$ref": "https://schemas.aiptc.dev/contracts/v0.1.0/__shared.schema.json#/$defs/JsonValue"
      }
    },
    "extensions": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^[a-z0-9]([a-z0-9._:-]{0,62}[a-z0-9])?$"
      },
      "additionalProperties": {
        "$ref": "https://schemas.aiptc.dev/contracts/v0.1.0/__shared.schema.json#/$defs/JsonValue"
      },
      "description": "Namespaced, non-contractual extension data. Unknown keys MUST be ignored."
    }
  },
  "required": [
    "messages"
  ],
  "additionalProperties": false
}
