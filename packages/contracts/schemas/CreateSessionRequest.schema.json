{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.aiptc.dev/contracts/v0.1.0/CreateSessionRequest.schema.json",
  "title": "Create session request",
  "description": "Payload accepted when creating a session.",
  "x-contract": {
    "id": "CreateSessionRequest",
    "group": "session",
    "contractsVersion": "0.1.0",
    "foundational": false
  },
  "type": "object",
  "properties": {
    "engagementId": {
      "type": "string",
      "pattern": "^eng_(?:[0-9A-HJKMNP-TV-Z]{26}|[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12})$",
      "description": "Engagement identifier (`eng_<ulid|uuid>`)"
    },
    "authorizationId": {
      "type": "string",
      "pattern": "^auth_(?:[0-9A-HJKMNP-TV-Z]{26}|[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12})$",
      "description": "Authorization record identifier (`auth_<ulid|uuid>`)"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "description": "Short human-readable label"
    },
    "description": {
      "type": "string",
      "maxLength": 8000,
      "description": "Human-readable description (markdown allowed)"
    },
    "autonomy": {
      "type": "string",
      "enum": [
        "advisory",
        "assisted",
        "supervised",
        "autonomous",
        "dry-run"
      ]
    },
    "scope": {
      "$ref": "https://schemas.aiptc.dev/contracts/v0.1.0/EngagementScope.schema.json"
    },
    "ownerActorId": {
      "type": "string",
      "pattern": "^act_(?:[0-9A-HJKMNP-TV-Z]{26}|[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12})$",
      "description": "Actor identifier (`act_<ulid|uuid>`)"
    },
    "modelPolicy": {
      "type": "object",
      "properties": {
        "preferred": {
          "maxItems": 16,
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 200
          }
        },
        "fallback": {
          "maxItems": 16,
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 200
          }
        },
        "requireLocalOnly": {
          "type": "boolean"
        },
        "maxEgressSensitivity": {
          "type": "string",
          "enum": [
            "public",
            "internal",
            "confidential",
            "restricted",
            "secret"
          ],
          "description": "Handling classification; drives redaction and egress policy"
        },
        "temperature": {
          "type": "number",
          "minimum": 0,
          "maximum": 2
        },
        "maxOutputTokens": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "seed": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        }
      },
      "additionalProperties": false
    },
    "budget": {
      "type": "object",
      "properties": {
        "maxWallClockMs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2147483647,
          "description": "Duration in milliseconds"
        },
        "maxModelCalls": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "maxInputTokens": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "maxOutputTokens": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "maxToolInvocations": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "maxCost": {
          "type": "object",
          "properties": {
            "currency": {
              "type": "string",
              "pattern": "^[A-Z]{3}$",
              "description": "ISO-4217 currency code"
            },
            "minorUnits": {
              "type": "integer",
              "minimum": -9007199254740991,
              "maximum": 9007199254740991
            }
          },
          "required": [
            "currency",
            "minorUnits"
          ],
          "additionalProperties": false
        },
        "softStopThreshold": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "Value in the closed interval [0, 1]"
        }
      },
      "additionalProperties": false
    },
    "tags": {
      "maxItems": 64,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 64,
        "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:\\/-]*$",
        "description": "Free-form tag"
      }
    },
    "metadata": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "$ref": "https://schemas.aiptc.dev/contracts/v0.1.0/__shared.schema.json#/$defs/JsonValue"
      }
    },
    "extensions": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^[a-z0-9]([a-z0-9._:-]{0,62}[a-z0-9])?$"
      },
      "additionalProperties": {
        "$ref": "https://schemas.aiptc.dev/contracts/v0.1.0/__shared.schema.json#/$defs/JsonValue"
      },
      "description": "Namespaced, non-contractual extension data. Unknown keys MUST be ignored."
    }
  },
  "required": [
    "engagementId",
    "title",
    "autonomy",
    "scope",
    "ownerActorId"
  ],
  "additionalProperties": false
}
