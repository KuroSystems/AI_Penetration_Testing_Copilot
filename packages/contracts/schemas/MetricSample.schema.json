{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.aiptc.dev/contracts/v0.1.0/MetricSample.schema.json",
  "title": "Metric sample",
  "description": "A single telemetry measurement.",
  "x-contract": {
    "id": "MetricSample",
    "group": "audit",
    "contractsVersion": "0.1.0",
    "foundational": false
  },
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[a-z][a-z0-9_]*(\\.[a-z0-9_]+)*$"
    },
    "kind": {
      "type": "string",
      "enum": [
        "counter",
        "gauge",
        "histogram",
        "summary"
      ]
    },
    "value": {
      "type": "number"
    },
    "unit": {
      "type": "string",
      "enum": [
        "count",
        "milliseconds",
        "bytes",
        "tokens",
        "ratio",
        "currency-minor"
      ]
    },
    "attributes": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "maxLength": 64
      },
      "additionalProperties": {
        "anyOf": [
          {
            "type": "string",
            "maxLength": 128
          },
          {
            "type": "number"
          },
          {
            "type": "boolean"
          }
        ]
      }
    },
    "recordedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$",
      "description": "RFC 3339 timestamp with explicit UTC offset, e.g. 2026-07-30T10:15:00.000Z"
    },
    "sessionId": {
      "type": "string",
      "pattern": "^ses_(?:[0-9A-HJKMNP-TV-Z]{26}|[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12})$",
      "description": "Session identifier (`ses_<ulid|uuid>`)"
    }
  },
  "required": [
    "name",
    "kind",
    "value",
    "recordedAt"
  ],
  "additionalProperties": false
}
