{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.aiptc.dev/contracts/v0.1.0/InstalledPlugin.schema.json",
  "title": "Installed plugin",
  "description": "Host-side record of an installed plugin.",
  "x-contract": {
    "id": "InstalledPlugin",
    "group": "plugin",
    "contractsVersion": "0.1.0",
    "foundational": false
  },
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^plg_(?:[0-9A-HJKMNP-TV-Z]{26}|[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12})$",
      "description": "Plugin identifier (`plg_<ulid|uuid>`)"
    },
    "manifest": {
      "$ref": "https://schemas.aiptc.dev/contracts/v0.1.0/PluginManifest.schema.json"
    },
    "installedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$",
      "description": "RFC 3339 timestamp with explicit UTC offset, e.g. 2026-07-30T10:15:00.000Z"
    },
    "installedFrom": {
      "type": "string",
      "maxLength": 2048
    },
    "enabled": {
      "type": "boolean"
    },
    "grantedPermissions": {
      "type": "object",
      "properties": {
        "network": {
          "type": "object",
          "properties": {
            "mode": {
              "type": "string",
              "enum": [
                "none",
                "scope-targets",
                "allowlist",
                "any"
              ]
            },
            "allowHosts": {
              "maxItems": 256,
              "type": "array",
              "items": {
                "type": "string",
                "maxLength": 253
              }
            },
            "allowPorts": {
              "maxItems": 128,
              "type": "array",
              "items": {
                "type": "integer",
                "minimum": 0,
                "maximum": 65535
              }
            },
            "allowProtocols": {
              "maxItems": 16,
              "type": "array",
              "items": {
                "type": "string",
                "enum": [
                  "http",
                  "https",
                  "tcp",
                  "udp",
                  "dns",
                  "ssh",
                  "ftp",
                  "smb"
                ]
              }
            }
          },
          "required": [
            "mode"
          ],
          "additionalProperties": false
        },
        "filesystem": {
          "type": "object",
          "properties": {
            "mode": {
              "type": "string",
              "enum": [
                "none",
                "workspace",
                "allowlist",
                "any"
              ]
            },
            "readPaths": {
              "maxItems": 64,
              "type": "array",
              "items": {
                "type": "string",
                "maxLength": 1024
              }
            },
            "writePaths": {
              "maxItems": 64,
              "type": "array",
              "items": {
                "type": "string",
                "maxLength": 1024
              }
            }
          },
          "required": [
            "mode"
          ],
          "additionalProperties": false
        },
        "process": {
          "type": "object",
          "properties": {
            "mode": {
              "type": "string",
              "enum": [
                "none",
                "allowlist"
              ]
            },
            "allowBinaries": {
              "maxItems": 64,
              "type": "array",
              "items": {
                "type": "string",
                "maxLength": 200
              }
            }
          },
          "required": [
            "mode"
          ],
          "additionalProperties": false
        },
        "environment": {
          "maxItems": 64,
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 128
          }
        },
        "model": {
          "type": "object",
          "properties": {
            "allowed": {
              "type": "boolean"
            },
            "localOnly": {
              "type": "boolean"
            },
            "maxCallsPerInvocation": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            }
          },
          "required": [
            "allowed"
          ],
          "additionalProperties": false
        },
        "storage": {
          "type": "object",
          "properties": {
            "read": {
              "maxItems": 32,
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 96,
                "pattern": "^[a-z0-9]([a-z0-9-]*[a-z0-9])?(\\.[a-z0-9]([a-z0-9-]*[a-z0-9])?)*$",
                "description": "Lowercase machine name, e.g. \"recon.port-scan\""
              }
            },
            "write": {
              "maxItems": 32,
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 96,
                "pattern": "^[a-z0-9]([a-z0-9-]*[a-z0-9])?(\\.[a-z0-9]([a-z0-9-]*[a-z0-9])?)*$",
                "description": "Lowercase machine name, e.g. \"recon.port-scan\""
              }
            },
            "privateState": {
              "type": "boolean"
            }
          },
          "additionalProperties": false
        },
        "events": {
          "type": "object",
          "properties": {
            "subscribe": {
              "maxItems": 64,
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128,
                "pattern": "^(\\*\\*|([a-z0-9-]+|\\*)(\\.([a-z0-9-]+|\\*))*(\\.\\*\\*)?)$",
                "description": "Subscription pattern, e.g. \"session.*.completed\" or \"audit.**\""
              }
            }
          },
          "additionalProperties": false
        },
        "engineCalls": {
          "maxItems": 64,
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 3,
            "maxLength": 128,
            "pattern": "^[a-z][a-z0-9-]*(\\.[a-z0-9-]+){1,4}$",
            "description": "Dotted message name, e.g. \"session.step.completed\""
          }
        },
        "maxSensitivity": {
          "type": "string",
          "enum": [
            "public",
            "internal",
            "confidential",
            "restricted",
            "secret"
          ],
          "description": "Handling classification; drives redaction and egress policy"
        }
      },
      "additionalProperties": false
    },
    "config": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "$ref": "https://schemas.aiptc.dev/contracts/v0.1.0/__shared.schema.json#/$defs/JsonValue"
      }
    },
    "state": {
      "type": "string",
      "enum": [
        "installed",
        "activating",
        "active",
        "inactive",
        "failed",
        "quarantined"
      ]
    },
    "lastError": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "description": "Short human-readable label"
    },
    "extensions": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^[a-z0-9]([a-z0-9._:-]{0,62}[a-z0-9])?$"
      },
      "additionalProperties": {
        "$ref": "https://schemas.aiptc.dev/contracts/v0.1.0/__shared.schema.json#/$defs/JsonValue"
      },
      "description": "Namespaced, non-contractual extension data. Unknown keys MUST be ignored."
    }
  },
  "required": [
    "id",
    "manifest",
    "installedAt",
    "enabled",
    "state"
  ],
  "additionalProperties": false
}
