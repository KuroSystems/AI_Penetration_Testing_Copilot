{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.aiptc.dev/contracts/v0.1.0/ResponseEnvelope.schema.json",
  "title": "Response envelope",
  "description": "Terminal reply to a request.",
  "x-contract": {
    "id": "ResponseEnvelope",
    "group": "messaging",
    "contractsVersion": "0.1.0",
    "foundational": false
  },
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "string",
      "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(?:-((?:0|[1-9]\\d*|\\d*[a-zA-Z-][0-9a-zA-Z-]*)(?:\\.(?:0|[1-9]\\d*|\\d*[a-zA-Z-][0-9a-zA-Z-]*))*))?(?:\\+([0-9a-zA-Z-]+(?:\\.[0-9a-zA-Z-]+)*))?$",
      "description": "Version of the contract schema this document conforms to"
    },
    "id": {
      "type": "string",
      "pattern": "^msg_(?:[0-9A-HJKMNP-TV-Z]{26}|[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12})$",
      "description": "Engine message identifier (`msg_<ulid|uuid>`)"
    },
    "name": {
      "type": "string",
      "minLength": 3,
      "maxLength": 128,
      "pattern": "^[a-z][a-z0-9-]*(\\.[a-z0-9-]+){1,4}$",
      "description": "Dotted message name, e.g. \"session.step.completed\""
    },
    "source": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^(\\*|[a-z][a-z0-9-]{1,31}(\\/(egn_[0-9A-HJKMNP-TV-Z]{26}|[a-z0-9-]{1,64}))?)$",
      "description": "Bus address: \"<engine>\", \"<engine>/<instance>\" or \"*\""
    },
    "createdAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$",
      "description": "RFC 3339 timestamp with explicit UTC offset, e.g. 2026-07-30T10:15:00.000Z"
    },
    "correlationId": {
      "type": "string",
      "pattern": "^cor_(?:[0-9A-HJKMNP-TV-Z]{26}|[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12})$",
      "description": "Correlation identifier (`cor_<ulid|uuid>`)"
    },
    "causationId": {
      "type": "string",
      "pattern": "^msg_(?:[0-9A-HJKMNP-TV-Z]{26}|[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12})$",
      "description": "Engine message identifier (`msg_<ulid|uuid>`)"
    },
    "sessionId": {
      "type": "string",
      "pattern": "^ses_(?:[0-9A-HJKMNP-TV-Z]{26}|[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12})$",
      "description": "Session identifier (`ses_<ulid|uuid>`)"
    },
    "conversationId": {
      "type": "string",
      "pattern": "^cnv_(?:[0-9A-HJKMNP-TV-Z]{26}|[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12})$",
      "description": "Conversation identifier (`cnv_<ulid|uuid>`)"
    },
    "actor": {
      "$ref": "https://schemas.aiptc.dev/contracts/v0.1.0/ActorRef.schema.json"
    },
    "trace": {
      "type": "object",
      "properties": {
        "traceparent": {
          "type": "string",
          "pattern": "^00-[0-9a-f]{32}-[0-9a-f]{16}-[0-9a-f]{2}$",
          "description": "W3C traceparent header"
        },
        "tracestate": {
          "type": "string",
          "maxLength": 512
        }
      },
      "required": [
        "traceparent"
      ],
      "additionalProperties": false
    },
    "priority": {
      "type": "string",
      "enum": [
        "low",
        "normal",
        "high",
        "critical"
      ]
    },
    "deliveryMode": {
      "type": "string",
      "enum": [
        "at-most-once",
        "at-least-once"
      ],
      "description": "At-least-once requires handlers to be idempotent via idempotencyKey"
    },
    "idempotencyKey": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "attempt": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "ttlMs": {
      "type": "integer",
      "minimum": 0,
      "maximum": 2147483647,
      "description": "Duration in milliseconds"
    },
    "contentType": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9!#$&^_.+-]{0,126}\\/[a-z0-9][a-z0-9!#$&^_.+-]{0,126}(;\\s?.+)?$",
      "description": "IANA media type, e.g. \"application/json\""
    },
    "payloadSchema": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "maxLength": 128
        },
        "version": {
          "type": "string",
          "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(?:-((?:0|[1-9]\\d*|\\d*[a-zA-Z-][0-9a-zA-Z-]*)(?:\\.(?:0|[1-9]\\d*|\\d*[a-zA-Z-][0-9a-zA-Z-]*))*))?(?:\\+([0-9a-zA-Z-]+(?:\\.[0-9a-zA-Z-]+)*))?$",
          "description": "Semantic version (semver 2.0.0)"
        }
      },
      "required": [
        "id"
      ],
      "additionalProperties": false
    },
    "sensitivity": {
      "type": "string",
      "enum": [
        "public",
        "internal",
        "confidential",
        "restricted",
        "secret"
      ],
      "description": "Handling classification; drives redaction and egress policy"
    },
    "redactions": {
      "maxItems": 64,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "pointer": {
            "type": "string",
            "pattern": "^(\\/(([^/~])|(~[01]))*)*$"
          },
          "mode": {
            "type": "string",
            "enum": [
              "none",
              "mask",
              "hash",
              "drop",
              "tokenize"
            ]
          },
          "reason": {
            "type": "string",
            "maxLength": 8000,
            "description": "Human-readable description (markdown allowed)"
          }
        },
        "required": [
          "pointer",
          "mode"
        ],
        "additionalProperties": false
      }
    },
    "headers": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "maxLength": 64
      },
      "additionalProperties": {
        "type": "string",
        "maxLength": 1024
      }
    },
    "extensions": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^[a-z0-9]([a-z0-9._:-]{0,62}[a-z0-9])?$"
      },
      "additionalProperties": {
        "$ref": "https://schemas.aiptc.dev/contracts/v0.1.0/__shared.schema.json#/$defs/JsonValue"
      },
      "description": "Namespaced, non-contractual extension data. Unknown keys MUST be ignored."
    },
    "kind": {
      "type": "string",
      "const": "response"
    },
    "destination": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^(\\*|[a-z][a-z0-9-]{1,31}(\\/(egn_[0-9A-HJKMNP-TV-Z]{26}|[a-z0-9-]{1,64}))?)$",
      "description": "Bus address: \"<engine>\", \"<engine>/<instance>\" or \"*\""
    },
    "inReplyTo": {
      "type": "string",
      "pattern": "^msg_(?:[0-9A-HJKMNP-TV-Z]{26}|[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12})$",
      "description": "Engine message identifier (`msg_<ulid|uuid>`)"
    },
    "status": {
      "type": "string",
      "enum": [
        "ok",
        "error",
        "partial",
        "cancelled"
      ]
    },
    "payload": {
      "$ref": "https://schemas.aiptc.dev/contracts/v0.1.0/__shared.schema.json#/$defs/JsonValue"
    },
    "error": {
      "$ref": "https://schemas.aiptc.dev/contracts/v0.1.0/__shared.schema.json#/$defs/ContractError"
    },
    "durationMs": {
      "type": "integer",
      "minimum": 0,
      "maximum": 2147483647,
      "description": "Duration in milliseconds"
    }
  },
  "required": [
    "schemaVersion",
    "id",
    "name",
    "source",
    "createdAt",
    "correlationId",
    "kind",
    "destination",
    "inReplyTo",
    "status"
  ],
  "additionalProperties": false
}
