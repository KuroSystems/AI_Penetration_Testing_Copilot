{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.aiptc.dev/contracts/v0.1.0/ActorRef.schema.json",
  "title": "Actor reference",
  "description": "Compact actor reference for high-volume records.",
  "x-contract": {
    "id": "ActorRef",
    "group": "domain",
    "contractsVersion": "0.1.0",
    "foundational": false
  },
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^act_(?:[0-9A-HJKMNP-TV-Z]{26}|[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12})$",
      "description": "Actor identifier (`act_<ulid|uuid>`)"
    },
    "kind": {
      "type": "string",
      "enum": [
        "human",
        "engine",
        "model",
        "plugin",
        "system",
        "external"
      ]
    },
    "displayName": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "description": "Short human-readable label"
    }
  },
  "required": [
    "id",
    "kind"
  ],
  "additionalProperties": false
}
