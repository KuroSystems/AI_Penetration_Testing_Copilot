{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.aiptc.dev/contracts/v0.1.0/SessionStep.schema.json",
  "title": "Session step",
  "description": "A single planned or executed unit of work within a session.",
  "x-contract": {
    "id": "SessionStep",
    "group": "session",
    "contractsVersion": "0.1.0",
    "foundational": false
  },
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^stp_(?:[0-9A-HJKMNP-TV-Z]{26}|[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12})$",
      "description": "Session step identifier (`stp_<ulid|uuid>`)"
    },
    "sessionId": {
      "type": "string",
      "pattern": "^ses_(?:[0-9A-HJKMNP-TV-Z]{26}|[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12})$",
      "description": "Session identifier (`ses_<ulid|uuid>`)"
    },
    "sequence": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "parentStepId": {
      "type": "string",
      "pattern": "^stp_(?:[0-9A-HJKMNP-TV-Z]{26}|[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12})$",
      "description": "Session step identifier (`stp_<ulid|uuid>`)"
    },
    "taskId": {
      "type": "string",
      "pattern": "^tsk_(?:[0-9A-HJKMNP-TV-Z]{26}|[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12})$",
      "description": "Task identifier (`tsk_<ulid|uuid>`)"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "description": "Short human-readable label"
    },
    "intent": {
      "type": "string",
      "maxLength": 8000,
      "description": "Human-readable description (markdown allowed)"
    },
    "phase": {
      "type": "string",
      "enum": [
        "scoping",
        "reconnaissance",
        "enumeration",
        "vulnerability-analysis",
        "exploitation",
        "post-exploitation",
        "lateral-movement",
        "reporting",
        "remediation-verification",
        "closed"
      ]
    },
    "activityClass": {
      "type": "string",
      "enum": [
        "passive-recon",
        "active-scan",
        "vulnerability-scan",
        "authenticated-scan",
        "exploitation",
        "post-exploitation",
        "lateral-movement",
        "privilege-escalation",
        "persistence",
        "data-exfiltration-simulation",
        "denial-of-service",
        "social-engineering",
        "physical",
        "wireless",
        "source-code-review",
        "configuration-review"
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "planned",
        "queued",
        "awaiting-approval",
        "running",
        "succeeded",
        "failed",
        "skipped",
        "cancelled"
      ]
    },
    "executor": {
      "type": "string",
      "enum": [
        "model",
        "tool",
        "plugin",
        "human",
        "internal"
      ]
    },
    "executorRef": {
      "type": "string",
      "maxLength": 200
    },
    "promptModuleId": {
      "type": "string",
      "pattern": "^pmd_(?:[0-9A-HJKMNP-TV-Z]{26}|[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12})$",
      "description": "Prompt module identifier (`pmd_<ulid|uuid>`)"
    },
    "pluginId": {
      "type": "string",
      "pattern": "^plg_(?:[0-9A-HJKMNP-TV-Z]{26}|[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12})$",
      "description": "Plugin identifier (`plg_<ulid|uuid>`)"
    },
    "input": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "$ref": "https://schemas.aiptc.dev/contracts/v0.1.0/__shared.schema.json#/$defs/JsonValue"
      }
    },
    "output": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "$ref": "https://schemas.aiptc.dev/contracts/v0.1.0/__shared.schema.json#/$defs/JsonValue"
      }
    },
    "error": {
      "$ref": "https://schemas.aiptc.dev/contracts/v0.1.0/__shared.schema.json#/$defs/ContractError"
    },
    "approvalId": {
      "type": "string",
      "pattern": "^apr_(?:[0-9A-HJKMNP-TV-Z]{26}|[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12})$",
      "description": "Approval identifier (`apr_<ulid|uuid>`)"
    },
    "startedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$",
      "description": "RFC 3339 timestamp with explicit UTC offset, e.g. 2026-07-30T10:15:00.000Z"
    },
    "endedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$",
      "description": "RFC 3339 timestamp with explicit UTC offset, e.g. 2026-07-30T10:15:00.000Z"
    },
    "durationMs": {
      "type": "integer",
      "minimum": 0,
      "maximum": 2147483647,
      "description": "Duration in milliseconds"
    },
    "producedFindingIds": {
      "maxItems": 256,
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^fnd_(?:[0-9A-HJKMNP-TV-Z]{26}|[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12})$",
        "description": "Finding identifier (`fnd_<ulid|uuid>`)"
      }
    },
    "producedArtifactIds": {
      "maxItems": 256,
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^art_(?:[0-9A-HJKMNP-TV-Z]{26}|[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12})$",
        "description": "Artifact identifier (`art_<ulid|uuid>`)"
      }
    },
    "dependsOn": {
      "maxItems": 64,
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^stp_(?:[0-9A-HJKMNP-TV-Z]{26}|[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12})$",
        "description": "Session step identifier (`stp_<ulid|uuid>`)"
      }
    },
    "retryOf": {
      "type": "string",
      "pattern": "^stp_(?:[0-9A-HJKMNP-TV-Z]{26}|[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12})$",
      "description": "Session step identifier (`stp_<ulid|uuid>`)"
    },
    "attempt": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "tags": {
      "maxItems": 64,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 64,
        "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:\\/-]*$",
        "description": "Free-form tag"
      }
    },
    "extensions": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^[a-z0-9]([a-z0-9._:-]{0,62}[a-z0-9])?$"
      },
      "additionalProperties": {
        "$ref": "https://schemas.aiptc.dev/contracts/v0.1.0/__shared.schema.json#/$defs/JsonValue"
      },
      "description": "Namespaced, non-contractual extension data. Unknown keys MUST be ignored."
    }
  },
  "required": [
    "id",
    "sessionId",
    "sequence",
    "title",
    "status"
  ],
  "additionalProperties": false
}
