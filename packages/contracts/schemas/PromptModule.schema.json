{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.aiptc.dev/contracts/v0.1.0/PromptModule.schema.json",
  "title": "Prompt module",
  "description": "A versioned, composable, testable prompt unit with a declared input/output contract and safety metadata.",
  "x-contract": {
    "id": "PromptModule",
    "group": "prompt",
    "contractsVersion": "0.1.0",
    "foundational": true
  },
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "string",
      "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(?:-((?:0|[1-9]\\d*|\\d*[a-zA-Z-][0-9a-zA-Z-]*)(?:\\.(?:0|[1-9]\\d*|\\d*[a-zA-Z-][0-9a-zA-Z-]*))*))?(?:\\+([0-9a-zA-Z-]+(?:\\.[0-9a-zA-Z-]+)*))?$",
      "description": "Version of the contract schema this document conforms to"
    },
    "id": {
      "type": "string",
      "pattern": "^pmd_(?:[0-9A-HJKMNP-TV-Z]{26}|[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12})$",
      "description": "Prompt module identifier (`pmd_<ulid|uuid>`)"
    },
    "key": {
      "type": "string",
      "minLength": 1,
      "maxLength": 96,
      "pattern": "^[a-z0-9]([a-z0-9-]*[a-z0-9])?(\\.[a-z0-9]([a-z0-9-]*[a-z0-9])?)*$",
      "description": "Lowercase machine name, e.g. \"recon.port-scan\""
    },
    "version": {
      "type": "string",
      "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(?:-((?:0|[1-9]\\d*|\\d*[a-zA-Z-][0-9a-zA-Z-]*)(?:\\.(?:0|[1-9]\\d*|\\d*[a-zA-Z-][0-9a-zA-Z-]*))*))?(?:\\+([0-9a-zA-Z-]+(?:\\.[0-9a-zA-Z-]+)*))?$",
      "description": "Semantic version (semver 2.0.0)"
    },
    "kind": {
      "type": "string",
      "enum": [
        "persona",
        "guardrail",
        "task",
        "fragment",
        "tool-instruction",
        "output-format",
        "evaluation",
        "report-template"
      ]
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "description": "Short human-readable label"
    },
    "description": {
      "type": "string",
      "maxLength": 8000,
      "description": "Human-readable description (markdown allowed)"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "review",
        "approved",
        "deprecated",
        "revoked"
      ]
    },
    "language": {
      "type": "string",
      "pattern": "^[a-zA-Z]{2,3}(-[a-zA-Z]{4})?(-([a-zA-Z]{2}|[0-9]{3}))?$",
      "description": "BCP-47 language tag, e.g. \"en\" or \"en-GB\""
    },
    "templateEngine": {
      "type": "string",
      "enum": [
        "none",
        "mustache",
        "handlebars",
        "liquid",
        "fstring"
      ]
    },
    "parts": {
      "minItems": 1,
      "maxItems": 64,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "role": {
            "type": "string",
            "enum": [
              "system",
              "developer",
              "user",
              "assistant",
              "tool"
            ]
          },
          "content": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200000
          },
          "when": {
            "type": "string",
            "maxLength": 200
          },
          "order": {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991
          },
          "cacheable": {
            "type": "boolean"
          }
        },
        "required": [
          "role",
          "content"
        ],
        "additionalProperties": false
      }
    },
    "extends": {
      "maxItems": 16,
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 160
      }
    },
    "requires": {
      "maxItems": 32,
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 160
      }
    },
    "conflictsWith": {
      "maxItems": 32,
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 160
      }
    },
    "priority": {
      "type": "integer",
      "minimum": 0,
      "maximum": 1000
    },
    "variables": {
      "maxItems": 64,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "pattern": "^[a-zA-Z_][a-zA-Z0-9_]*$"
          },
          "description": {
            "type": "string",
            "maxLength": 8000,
            "description": "Human-readable description (markdown allowed)"
          },
          "type": {
            "type": "string",
            "enum": [
              "string",
              "number",
              "integer",
              "boolean",
              "object",
              "array",
              "json"
            ]
          },
          "required": {
            "type": "boolean"
          },
          "schema": {
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {
              "$ref": "https://schemas.aiptc.dev/contracts/v0.1.0/__shared.schema.json#/$defs/JsonValue"
            }
          },
          "default": {
            "$ref": "https://schemas.aiptc.dev/contracts/v0.1.0/__shared.schema.json#/$defs/JsonValue"
          },
          "example": {
            "$ref": "https://schemas.aiptc.dev/contracts/v0.1.0/__shared.schema.json#/$defs/JsonValue"
          },
          "maxLength": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          },
          "sensitivity": {
            "type": "string",
            "enum": [
              "public",
              "internal",
              "confidential",
              "restricted",
              "secret"
            ],
            "description": "Handling classification; drives redaction and egress policy"
          },
          "trust": {
            "type": "string",
            "enum": [
              "trusted",
              "untrusted"
            ]
          },
          "sanitizer": {
            "type": "string",
            "enum": [
              "none",
              "escape",
              "fenced",
              "strip-control-chars",
              "json-stringify"
            ]
          }
        },
        "required": [
          "name",
          "type",
          "required"
        ],
        "additionalProperties": false
      }
    },
    "outputSchema": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "$ref": "https://schemas.aiptc.dev/contracts/v0.1.0/__shared.schema.json#/$defs/JsonValue"
      }
    },
    "outputFormat": {
      "type": "string",
      "enum": [
        "text",
        "markdown",
        "json",
        "json-schema",
        "tool-calls"
      ]
    },
    "expectedTools": {
      "maxItems": 64,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 96,
        "pattern": "^[a-z0-9]([a-z0-9-]*[a-z0-9])?(\\.[a-z0-9]([a-z0-9-]*[a-z0-9])?)*$",
        "description": "Lowercase machine name, e.g. \"recon.port-scan\""
      }
    },
    "modelRequirements": {
      "type": "object",
      "properties": {
        "minContextTokens": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "maxOutputTokens": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "capabilities": {
          "maxItems": 16,
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "chat",
              "completion",
              "tools",
              "parallel-tool-calls",
              "json-mode",
              "json-schema",
              "streaming",
              "vision",
              "audio-input",
              "embeddings",
              "reranking",
              "reasoning",
              "logprobs",
              "seed",
              "system-prompt",
              "prefix-caching",
              "stop-sequences",
              "token-counting"
            ]
          }
        },
        "preferredModels": {
          "maxItems": 16,
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 200
          }
        },
        "temperature": {
          "type": "number",
          "minimum": 0,
          "maximum": 2
        },
        "topP": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "stopSequences": {
          "maxItems": 8,
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 64
          }
        },
        "estimatedPromptTokens": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "additionalProperties": false
    },
    "safety": {
      "type": "object",
      "properties": {
        "activityClasses": {
          "maxItems": 16,
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "passive-recon",
              "active-scan",
              "vulnerability-scan",
              "authenticated-scan",
              "exploitation",
              "post-exploitation",
              "lateral-movement",
              "privilege-escalation",
              "persistence",
              "data-exfiltration-simulation",
              "denial-of-service",
              "social-engineering",
              "physical",
              "wireless",
              "source-code-review",
              "configuration-review"
            ]
          }
        },
        "requiresApproval": {
          "type": "boolean"
        },
        "requiresScope": {
          "type": "boolean"
        },
        "maxSensitivity": {
          "type": "string",
          "enum": [
            "public",
            "internal",
            "confidential",
            "restricted",
            "secret"
          ],
          "description": "Handling classification; drives redaction and egress policy"
        },
        "localModelsOnly": {
          "type": "boolean"
        },
        "reviewNotes": {
          "type": "string",
          "maxLength": 8000,
          "description": "Human-readable description (markdown allowed)"
        }
      },
      "additionalProperties": false
    },
    "examples": {
      "maxItems": 32,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200,
            "description": "Short human-readable label"
          },
          "variables": {
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {
              "$ref": "https://schemas.aiptc.dev/contracts/v0.1.0/__shared.schema.json#/$defs/JsonValue"
            }
          },
          "expectedOutput": {
            "type": "string",
            "maxLength": 20000
          },
          "inject": {
            "type": "boolean"
          }
        },
        "required": [
          "variables"
        ],
        "additionalProperties": false
      }
    },
    "evaluations": {
      "maxItems": 64,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200,
            "description": "Short human-readable label"
          },
          "kind": {
            "type": "string",
            "enum": [
              "contains",
              "not-contains",
              "regex",
              "json-schema",
              "llm-rubric",
              "exact"
            ]
          },
          "criterion": {
            "type": "string",
            "maxLength": 20000
          },
          "variables": {
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {
              "$ref": "https://schemas.aiptc.dev/contracts/v0.1.0/__shared.schema.json#/$defs/JsonValue"
            }
          },
          "threshold": {
            "type": "number",
            "minimum": 0,
            "maximum": 1,
            "description": "Value in the closed interval [0, 1]"
          },
          "severity": {
            "type": "string",
            "enum": [
              "warning",
              "error"
            ]
          }
        },
        "required": [
          "name",
          "kind",
          "criterion"
        ],
        "additionalProperties": false
      }
    },
    "author": {
      "type": "string",
      "maxLength": 200
    },
    "ownerActorId": {
      "type": "string",
      "pattern": "^act_(?:[0-9A-HJKMNP-TV-Z]{26}|[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12})$",
      "description": "Actor identifier (`act_<ulid|uuid>`)"
    },
    "license": {
      "type": "string",
      "maxLength": 64
    },
    "references": {
      "maxItems": 32,
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 2048,
        "format": "uri",
        "description": "Absolute URI"
      }
    },
    "contentDigest": {
      "type": "string",
      "pattern": "^(sha256|sha512|blake3):[a-f0-9]{32,128}$",
      "description": "Algorithm-prefixed content digest, e.g. \"sha256:<hex>\""
    },
    "contractsRange": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "description": "Semver range expression, e.g. \"^1.2.0\""
    },
    "createdAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$",
      "description": "RFC 3339 timestamp with explicit UTC offset, e.g. 2026-07-30T10:15:00.000Z"
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$",
      "description": "RFC 3339 timestamp with explicit UTC offset, e.g. 2026-07-30T10:15:00.000Z"
    },
    "deprecatedBy": {
      "type": "string",
      "maxLength": 160
    },
    "tags": {
      "maxItems": 64,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 64,
        "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:\\/-]*$",
        "description": "Free-form tag"
      }
    },
    "metadata": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "$ref": "https://schemas.aiptc.dev/contracts/v0.1.0/__shared.schema.json#/$defs/JsonValue"
      }
    },
    "extensions": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^[a-z0-9]([a-z0-9._:-]{0,62}[a-z0-9])?$"
      },
      "additionalProperties": {
        "$ref": "https://schemas.aiptc.dev/contracts/v0.1.0/__shared.schema.json#/$defs/JsonValue"
      },
      "description": "Namespaced, non-contractual extension data. Unknown keys MUST be ignored."
    }
  },
  "required": [
    "schemaVersion",
    "id",
    "key",
    "version",
    "kind",
    "title",
    "status",
    "templateEngine",
    "parts"
  ],
  "additionalProperties": false
}
