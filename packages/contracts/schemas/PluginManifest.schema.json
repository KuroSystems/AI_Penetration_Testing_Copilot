{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.aiptc.dev/contracts/v0.1.0/PluginManifest.schema.json",
  "title": "Plugin manifest",
  "description": "Declarative description of a plugin: what it contributes, how it runs, and exactly which capabilities it may use.",
  "x-contract": {
    "id": "PluginManifest",
    "group": "plugin",
    "contractsVersion": "0.1.0",
    "foundational": true
