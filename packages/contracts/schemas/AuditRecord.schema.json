{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.aiptc.dev/contracts/v0.1.0/AuditRecord.schema.json",
  "title": "Audit record",
  "description": "Immutable, hash-chained record of a security-relevant action.",
  "x-contract": {
    "id": "AuditRecord",
    "group": "audit",
    "contractsVersion": "0.1.0",
    "foundational": false
  },
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "string",
      "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(?:-((?:0|[1-9]\\d*|\\d*[a-zA-Z-][0-9a-zA-Z-]*)(?:\\.(?:0|[1-9]\\d*|\\d*[a-zA-Z-][0-9a-zA-Z-]*))*))?(?:\\+([0-9a-zA-Z-]+(?:\\.[0-9a-zA-Z-]+)*))?$",
      "description": "Version of the contract schema this document conforms to"
    },
    "id": {
      "type": "string",
      "pattern": "^aud_(?:[0-9A-HJKMNP-TV-Z]{26}|[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12})$",
      "description": "Audit record identifier (`aud_<ulid|uuid>`)"
    },
    "sequence": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "recordedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$",
      "description": "RFC 3339 timestamp with explicit UTC offset, e.g. 2026-07-30T10:15:00.000Z"
    },
    "occurredAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$",
      "description": "RFC 3339 timestamp with explicit UTC offset, e.g. 2026-07-30T10:15:00.000Z"
    },
    "action": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "category": {
      "type": "string",
      "enum": [
        "session",
        "authorization",
        "policy",
        "model",
        "tool",
        "plugin",
        "finding",
        "evidence",
        "storage",
        "configuration",
        "security",
        "system"
      ]
    },
    "outcome": {
      "type": "string",
      "enum": [
        "success",
        "failure",
        "denied",
        "partial",
        "pending"
      ]
    },
    "actor": {
      "$ref": "https://schemas.aiptc.dev/contracts/v0.1.0/ActorRef.schema.json"
    },
    "target": {
      "type": "string",
      "maxLength": 2048
    },
    "sessionId": {
      "type": "string",
      "pattern": "^ses_(?:[0-9A-HJKMNP-TV-Z]{26}|[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12})$",
      "description": "Session identifier (`ses_<ulid|uuid>`)"
    },
    "correlationId": {
      "type": "string",
      "pattern": "^cor_(?:[0-9A-HJKMNP-TV-Z]{26}|[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12})$",
      "description": "Correlation identifier (`cor_<ulid|uuid>`)"
    },
    "causationId": {
      "type": "string",
      "pattern": "^msg_(?:[0-9A-HJKMNP-TV-Z]{26}|[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12})$",
      "description": "Engine message identifier (`msg_<ulid|uuid>`)"
    },
    "activityClass": {
      "type": "string",
      "enum": [
        "passive-recon",
        "active-scan",
        "vulnerability-scan",
        "authenticated-scan",
        "exploitation",
        "post-exploitation",
        "lateral-movement",
        "privilege-escalation",
        "persistence",
        "data-exfiltration-simulation",
        "denial-of-service",
        "social-engineering",
        "physical",
        "wireless",
        "source-code-review",
        "configuration-review"
      ]
    },
    "summary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "description": "Short human-readable label"
    },
    "detail": {
      "type": "string",
      "maxLength": 8000,
      "description": "Human-readable description (markdown allowed)"
    },
    "data": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "$ref": "https://schemas.aiptc.dev/contracts/v0.1.0/__shared.schema.json#/$defs/JsonValue"
      }
    },
    "redacted": {
      "type": "boolean"
    },
    "sensitivity": {
      "type": "string",
      "enum": [
        "public",
        "internal",
        "confidential",
        "restricted",
        "secret"
      ],
      "description": "Handling classification; drives redaction and egress policy"
    },
    "error": {
      "$ref": "https://schemas.aiptc.dev/contracts/v0.1.0/__shared.schema.json#/$defs/ContractError"
    },
    "durationMs": {
      "type": "integer",
      "minimum": 0,
      "maximum": 2147483647,
      "description": "Duration in milliseconds"
    },
    "producerVersion": {
      "type": "string",
      "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(?:-((?:0|[1-9]\\d*|\\d*[a-zA-Z-][0-9a-zA-Z-]*)(?:\\.(?:0|[1-9]\\d*|\\d*[a-zA-Z-][0-9a-zA-Z-]*))*))?(?:\\+([0-9a-zA-Z-]+(?:\\.[0-9a-zA-Z-]+)*))?$",
      "description": "Semantic version (semver 2.0.0)"
    },
    "previousHash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$",
      "description": "Lowercase hex SHA-256 digest"
    },
    "hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$",
      "description": "Lowercase hex SHA-256 digest"
    },
    "extensions": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^[a-z0-9]([a-z0-9._:-]{0,62}[a-z0-9])?$"
      },
      "additionalProperties": {
        "$ref": "https://schemas.aiptc.dev/contracts/v0.1.0/__shared.schema.json#/$defs/JsonValue"
      },
      "description": "Namespaced, non-contractual extension data. Unknown keys MUST be ignored."
    }
  },
  "required": [
    "schemaVersion",
    "id",
    "sequence",
    "recordedAt",
    "action",
    "category",
    "outcome",
    "actor",
    "summary"
  ],
  "additionalProperties": false
}
