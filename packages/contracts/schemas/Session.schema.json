{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.aiptc.dev/contracts/v0.1.0/Session.schema.json",
  "title": "Session",
  "description": "The root aggregate of an engagement run: scope, authorisation, autonomy, budget, progress and outcomes.",
  "x-contract": {
    "id": "Session",
    "group": "session",
    "contractsVersion": "0.1.0",
    "foundational": true
  },
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "string",
      "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(?:-((?:0|[1-9]\\d*|\\d*[a-zA-Z-][0-9a-zA-Z-]*)(?:\\.(?:0|[1-9]\\d*|\\d*[a-zA-Z-][0-9a-zA-Z-]*))*))?(?:\\+([0-9a-zA-Z-]+(?:\\.[0-9a-zA-Z-]+)*))?$",
      "description": "Version of the contract schema this document conforms to"
    },
    "id": {
      "type": "string",
      "pattern": "^ses_(?:[0-9A-HJKMNP-TV-Z]{26}|[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12})$",
      "description": "Session identifier (`ses_<ulid|uuid>`)"
    },
    "engagementId": {
      "type": "string",
      "pattern": "^eng_(?:[0-9A-HJKMNP-TV-Z]{26}|[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12})$",
      "description": "Engagement identifier (`eng_<ulid|uuid>`)"
    },
    "authorizationId": {
      "type": "string",
      "pattern": "^auth_(?:[0-9A-HJKMNP-TV-Z]{26}|[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12})$",
      "description": "Authorization record identifier (`auth_<ulid|uuid>`)"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "description": "Short human-readable label"
    },
    "description": {
      "type": "string",
      "maxLength": 8000,
      "description": "Human-readable description (markdown allowed)"
    },
    "state": {
      "type": "string",
      "enum": [
        "draft",
        "authorized",
        "running",
        "awaiting-approval",
        "paused",
        "completed",
        "aborted",
        "failed",
        "archived"
      ]
    },
    "phase": {
      "type": "string",
      "enum": [
        "scoping",
        "reconnaissance",
        "enumeration",
        "vulnerability-analysis",
        "exploitation",
        "post-exploitation",
        "lateral-movement",
        "reporting",
        "remediation-verification",
        "closed"
      ]
    },
    "autonomy": {
      "type": "string",
      "enum": [
        "advisory",
        "assisted",
        "supervised",
        "autonomous",
        "dry-run"
      ]
    },
    "scope": {
      "$ref": "https://schemas.aiptc.dev/contracts/v0.1.0/EngagementScope.schema.json"
    },
    "objectives": {
      "maxItems": 64,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "maxLength": 64
          },
          "statement": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200,
            "description": "Short human-readable label"
          },
          "priority": {
            "type": "string",
            "enum": [
              "must",
              "should",
              "could"
            ]
          },
          "satisfied": {
            "type": "boolean"
          }
        },
        "required": [
          "id",
          "statement"
        ],
        "additionalProperties": false
      }
    },
    "participants": {
      "maxItems": 64,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "actorId": {
            "type": "string",
            "pattern": "^act_(?:[0-9A-HJKMNP-TV-Z]{26}|[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12})$",
            "description": "Actor identifier (`act_<ulid|uuid>`)"
          },
          "role": {
            "type": "string",
            "enum": [
              "owner",
              "lead-tester",
              "tester",
              "reviewer",
              "observer",
              "automation"
            ]
          },
          "joinedAt": {
            "type": "string",
            "format": "date-time",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$",
            "description": "RFC 3339 timestamp with explicit UTC offset, e.g. 2026-07-30T10:15:00.000Z"
          },
          "leftAt": {
            "type": "string",
            "format": "date-time",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$",
            "description": "RFC 3339 timestamp with explicit UTC offset, e.g. 2026-07-30T10:15:00.000Z"
          }
        },
        "required": [
          "actorId",
          "role"
        ],
        "additionalProperties": false
      }
    },
    "ownerActorId": {
      "type": "string",
      "pattern": "^act_(?:[0-9A-HJKMNP-TV-Z]{26}|[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12})$",
      "description": "Actor identifier (`act_<ulid|uuid>`)"
    },
    "modelPolicy": {
      "type": "object",
      "properties": {
        "preferred": {
          "maxItems": 16,
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 200
          }
        },
        "fallback": {
          "maxItems": 16,
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 200
          }
        },
        "requireLocalOnly": {
          "type": "boolean"
        },
        "maxEgressSensitivity": {
          "type": "string",
          "enum": [
            "public",
            "internal",
            "confidential",
            "restricted",
            "secret"
          ],
          "description": "Handling classification; drives redaction and egress policy"
        },
        "temperature": {
          "type": "number",
          "minimum": 0,
          "maximum": 2
        },
        "maxOutputTokens": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "seed": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        }
      },
      "additionalProperties": false
    },
    "budget": {
      "type": "object",
      "properties": {
        "maxWallClockMs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2147483647,
          "description": "Duration in milliseconds"
        },
        "maxModelCalls": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "maxInputTokens": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "maxOutputTokens": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "maxToolInvocations": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "maxCost": {
          "type": "object",
          "properties": {
            "currency": {
              "type": "string",
              "pattern": "^[A-Z]{3}$",
              "description": "ISO-4217 currency code"
            },
            "minorUnits": {
              "type": "integer",
              "minimum": -9007199254740991,
              "maximum": 9007199254740991
            }
          },
          "required": [
            "currency",
            "minorUnits"
          ],
          "additionalProperties": false
        },
        "softStopThreshold": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "Value in the closed interval [0, 1]"
        }
      },
      "additionalProperties": false
    },
    "usage": {
      "type": "object",
      "properties": {
        "elapsedMs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "modelCalls": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "inputTokens": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "outputTokens": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "toolInvocations": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "estimatedCost": {
          "type": "object",
          "properties": {
            "currency": {
              "type": "string",
              "pattern": "^[A-Z]{3}$",
              "description": "ISO-4217 currency code"
            },
            "minorUnits": {
              "type": "integer",
              "minimum": -9007199254740991,
              "maximum": 9007199254740991
            }
          },
          "required": [
            "currency",
            "minorUnits"
          ],
          "additionalProperties": false
        },
        "findingsCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "errorsCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "additionalProperties": false
    },
    "context": {
      "type": "object",
      "properties": {
        "conversationId": {
          "type": "string",
          "maxLength": 128
        },
        "knowledgeCollections": {
          "maxItems": 32,
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 128
          }
        },
        "pinnedPromptModuleIds": {
          "maxItems": 64,
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^pmd_(?:[0-9A-HJKMNP-TV-Z]{26}|[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12})$",
            "description": "Prompt module identifier (`pmd_<ulid|uuid>`)"
          }
        },
        "enabledPluginIds": {
          "maxItems": 128,
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^plg_(?:[0-9A-HJKMNP-TV-Z]{26}|[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12})$",
            "description": "Plugin identifier (`plg_<ulid|uuid>`)"
          }
        },
        "summary": {
          "type": "string",
          "maxLength": 8000,
          "description": "Human-readable description (markdown allowed)"
        },
        "scratchpad": {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "$ref": "https://schemas.aiptc.dev/contracts/v0.1.0/__shared.schema.json#/$defs/JsonValue"
          }
        }
      },
      "additionalProperties": false
    },
    "stepIds": {
      "maxItems": 10000,
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^stp_(?:[0-9A-HJKMNP-TV-Z]{26}|[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12})$",
        "description": "Session step identifier (`stp_<ulid|uuid>`)"
      }
    },
    "pendingApprovalIds": {
      "maxItems": 64,
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^apr_(?:[0-9A-HJKMNP-TV-Z]{26}|[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12})$",
        "description": "Approval identifier (`apr_<ulid|uuid>`)"
      }
    },
    "findingIds": {
      "maxItems": 10000,
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^fnd_(?:[0-9A-HJKMNP-TV-Z]{26}|[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12})$",
        "description": "Finding identifier (`fnd_<ulid|uuid>`)"
      }
    },
    "createdAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$",
      "description": "RFC 3339 timestamp with explicit UTC offset, e.g. 2026-07-30T10:15:00.000Z"
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$",
      "description": "RFC 3339 timestamp with explicit UTC offset, e.g. 2026-07-30T10:15:00.000Z"
    },
    "startedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$",
      "description": "RFC 3339 timestamp with explicit UTC offset, e.g. 2026-07-30T10:15:00.000Z"
    },
    "endedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$",
      "description": "RFC 3339 timestamp with explicit UTC offset, e.g. 2026-07-30T10:15:00.000Z"
    },
    "lastError": {
      "$ref": "https://schemas.aiptc.dev/contracts/v0.1.0/__shared.schema.json#/$defs/ContractError"
    },
    "revision": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "createdByVersion": {
      "type": "string",
      "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(?:-((?:0|[1-9]\\d*|\\d*[a-zA-Z-][0-9a-zA-Z-]*)(?:\\.(?:0|[1-9]\\d*|\\d*[a-zA-Z-][0-9a-zA-Z-]*))*))?(?:\\+([0-9a-zA-Z-]+(?:\\.[0-9a-zA-Z-]+)*))?$",
      "description": "Semantic version (semver 2.0.0)"
    },
    "timezone": {
      "type": "string",
      "maxLength": 64,
      "pattern": "^[A-Za-z_]+(?:\\/[A-Za-z0-9_+-]+){0,2}$",
      "description": "IANA timezone identifier"
    },
    "sensitivity": {
      "type": "string",
      "enum": [
        "public",
        "internal",
        "confidential",
        "restricted",
        "secret"
      ],
      "description": "Handling classification; drives redaction and egress policy"
    },
    "tags": {
      "maxItems": 64,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 64,
        "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:\\/-]*$",
        "description": "Free-form tag"
      }
    },
    "metadata": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "$ref": "https://schemas.aiptc.dev/contracts/v0.1.0/__shared.schema.json#/$defs/JsonValue"
      }
    },
    "extensions": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^[a-z0-9]([a-z0-9._:-]{0,62}[a-z0-9])?$"
      },
      "additionalProperties": {
        "$ref": "https://schemas.aiptc.dev/contracts/v0.1.0/__shared.schema.json#/$defs/JsonValue"
      },
      "description": "Namespaced, non-contractual extension data. Unknown keys MUST be ignored."
    }
  },
  "required": [
    "schemaVersion",
    "id",
    "engagementId",
    "title",
    "state",
    "autonomy",
    "scope",
    "ownerActorId",
    "createdAt",
    "updatedAt",
    "revision"
  ],
  "additionalProperties": false
}
