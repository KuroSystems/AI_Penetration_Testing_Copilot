{
  "name": "@ai-pentest/desktop",
  "version": "0.1.0",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder"
  },
  "dependencies": {
    "electron-is-dev": "^2.0.0"
  },
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.9.1"
  },
  "build": {
    "appId": "com.kurosystems.ai-pentest-copilot",
    "productName": "AI Pentest Copilot",
    "directories": {
      "output": "dist"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "KuroSystems",
        "repo": "AI_Penetration_Testing_Copilot"
      }
    ],
    "files": [
      "src/**/*",
      "../../client/dist/**/*",
      "../../server/dist/**/*"
    ],
    "mac": {
      "category": "public.app-category.developer-tools"
    }
  }
}
