{
  "name": "@aiptc/root",
  "private": true,
  "version": "0.0.0",
  "description": "AI Penetration Testing Copilot — monorepo root",
  "license": "MIT",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=20.10.0"
  },
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "schemas": "npm run schemas --workspaces --if-present",
    "verify": "npm run typecheck && npm run schemas:check --workspaces --if-present && npm run test"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "tsx": "^4.20.3",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
